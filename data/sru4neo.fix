	add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.@tag", "008")
	add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.value", "230601|2023||||||||||||o||||||||||ger||")
	
	#---datafields---
	do list(path:"datensatz.isbn[]", "var":"isbn")
	  add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
	  add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "020")
	  add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", " ")
	  add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", " ")
	  add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
	  add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
	  move_field("isbn", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
	end
	
	do list(path:"datensatz.issn[]", "var":"issn")
	  add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
	  add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "022")
