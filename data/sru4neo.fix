#externe maps
put_filemap("../data/ISO639-English.tsv", "lang", sep_char:"\t")

add_hash("searchRetrieveResponse")
add_field("searchRetrieveResponse.@xmlns", "http://www.loc.gov/zing/srw/")
add_field("searchRetrieveResponse.version", "1.2")
move_field("hitsCount.total", "searchRetrieveResponse.numberOfRecords")
add_hash("searchRetrieveResponse.records")

# --- marcXML records ---
do list(path:"results[]", "var":"datensatz")
    add_hash("searchRetrieveResponse.records.record.$append")

    add_field("searchRetrieveResponse.records.record.$last.recordSchema", "marcxml")
    add_field("searchRetrieveResponse.records.record.$last.recordPacking", "xml")

    add_hash("searchRetrieveResponse.records.record.$last.recordData")
    add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record")

    add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.@xmlns:marc", "http://www.loc.gov/MARC21/slim")
    add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:leader", "     cam  22     4  4500")
	
	#---controlfields---
	add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$append")
	add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.@tag", "001")
	copy_field("datensatz.identifierMain", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.value")

	add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$append")
	add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.@tag", "003")
	add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.value", "DE-290")
	
	add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$append")
	add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.@tag", "005")
	add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.value", "20230601093037.0")
	
	add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$append")
	add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.@tag", "007")
	add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:controlfield.$last.value", "tu")

