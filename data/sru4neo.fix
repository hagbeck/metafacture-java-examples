	  move_field("doi", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
	end
	
	do list(path:"datensatz.language[]", "var":"language")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "041")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", " ")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", " ")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
		lookup("language", "lang")
		move_field("language","searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
	end
	
	do list(path:"datensatz.classification[]", "var":"classification")
		if any_equal("classification.authority", "ddc")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "082")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", "0")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", " ")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
			move_field("classification.notation", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
		end
		if any_equal("classification.authority", "Regensburger Verbundklassifikation (RVK)")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "084")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", " ")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", " ")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
			move_field("classification.notation", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "2")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value", "rvk")
		end
	end
	
	do list(path:"datensatz.contributor[]", "var":"contributor")
		if any_match("contributor.role[]", "^(Autor\\*in|Author)$")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "100")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", "1")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", " ")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
			move_field("contributor.nameDisplay", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "4")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value", "aut")
		elsif any_match("contributor.role[]", "^(Hrsg.|Editor)$")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "700")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", "1")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", " ")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
			move_field("contributor.nameDisplay", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "4")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value", "edt")
		elsif any_match("contributor.role[]", "^(Übers.|Other|Contributor)$")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "700")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", "1")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", " ")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
			move_field("contributor.nameDisplay", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "4")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value", "ctb")
		end
	end
	
	if any_contain("datensatz.titleDisplay", ":")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "245")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", "0")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", "4")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
		copy_field("datensatz.titleDisplay", "titleCopyOne")
		copy_field("datensatz.titleDisplay", "titleCopyTwo")
		replace_all("titleCopyOne", " : .*", "")
		move_field("titleCopyOne", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "b")
		replace_all("titleCopyTwo", "^.*? : ", "")
		move_field("titleCopyTwo", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
		if exists(datensatz.creationStatement)
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "c")
			move_field("datensatz.creationStatement", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
		end
    end
	
	if none_contain("datensatz.titleDisplay", " : ")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "245")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", "0")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", "4")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
		move_field("datensatz.titleDisplay", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
		if exists(datensatz.creationStatement)
			add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "c")
