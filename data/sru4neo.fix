		  add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
		  move_field("relation.titleDisplay", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
		  if exists("relation.volume")
			  add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
			  add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "v")
