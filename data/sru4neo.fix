		move_field("datensatz.physicalDescription","searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
	end
	
	if exists("datensatz.relation[].titleDisplay")
		do list(path:"datensatz.relation[]", "var":"relation")
		  add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
		  add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "490")
		  add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", " ")
