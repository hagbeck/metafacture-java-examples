	if exists("datensatz.toc")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "505")
