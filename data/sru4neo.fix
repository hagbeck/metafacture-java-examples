	end
	
	do list(path:"datensatz.subject[]", "var":"subject")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "650")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", "4")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", " ")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "a")
		move_field("subject.subjectName", "searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
	end
	
	if exists("datensatz.availability.simple.access")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@tag", "856")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind1", "4")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.@ind2", "0")
		add_hash("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$append")
		add_field("searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.@code", "u")
		move_field("datensatz.availability.simple.access","searchRetrieveResponse.records.record.$last.recordData.marc:record.marc:datafield.$last.marc:subfield.$last.value")
	end

	copy_field("datensatz.identifierMain", "searchRetrieveResponse.records.record.$last.recordIdentifier")
	#---Todo: recordPosition---

end

retain("searchRetrieveResponse")